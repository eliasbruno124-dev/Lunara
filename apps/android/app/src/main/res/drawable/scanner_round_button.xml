<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#B35B355D" />
            <stroke android:width="1dp" android:color="#B3D86F61" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#CC397D79" />
            <stroke android:width="1dp" android:color="#CCFFF8F4" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#8F2A222B" />
            <stroke android:width="1dp" android:color="#665B355D" />
        </shape>
    </item>
</selector>
