<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scanner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="@dimen/scanner_land_panel_width"
        android:layout_height="match_parent"
        android:background="#ED151116"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lunara_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans"
            android:letterSpacing="0.13"
            android:text="@string/scanner_eyebrow"
            android:textAllCaps="true"
            android:textColor="@color/brand_coral"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans"
            android:text="@string/scanner_title"
            android:textColor="@color/brand_cream"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scanner_context_prompt"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:background="@drawable/scanner_prompt_background"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="@string/scan_qr_prompt"
            android:textColor="@color/brand_cream"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/scanner_torch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/scanner_round_button"
                android:contentDescription="@string/scanner_flashlight_on"
                android:padding="13dp"
                android:src="@drawable/ic_scanner_flashlight"
                app:tint="@color/brand_cream" />

            <ImageButton
                android:id="@+id/scanner_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/scanner_round_button"
                android:contentDescription="@string/scanner_close"
                android:padding="13dp"
                android:src="@drawable/ic_scanner_close"
                app:tint="@color/brand_cream" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:background="@color/brand_coral" />

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:zxing_possible_result_points="@color/brand_teal"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_scanner_layout="@layout/view_lunara_barcode_scanner"
        app:zxing_use_texture_view="true"
        app:zxing_viewfinder_laser="@color/brand_coral"
        app:zxing_viewfinder_laser_visibility="true"
        app:zxing_viewfinder_mask="#A8151116" />
</LinearLayout>
