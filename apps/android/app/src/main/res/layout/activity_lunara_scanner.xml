<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scanner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/scanner_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lunara_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:letterSpacing="0.13"
                android:text="@string/scanner_eyebrow"
                android:textAllCaps="true"
                android:textColor="@color/brand_coral"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="@string/scanner_title"
                android:textColor="@color/brand_cream"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/scanner_torch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/scanner_round_button"
            android:contentDescription="@string/scanner_flashlight_on"
            android:padding="13dp"
            android:src="@drawable/ic_scanner_flashlight"
            app:tint="@color/brand_cream" />

        <ImageButton
            android:id="@+id/scanner_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/scanner_round_button"
            android:contentDescription="@string/scanner_close"
            android:padding="13dp"
            android:src="@drawable/ic_scanner_close"
            app:tint="@color/brand_cream" />
    </LinearLayout>

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:zxing_possible_result_points="@color/brand_teal"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_scanner_layout="@layout/view_lunara_barcode_scanner"
        app:zxing_use_texture_view="true"
        app:zxing_viewfinder_laser="@color/brand_coral"
        app:zxing_viewfinder_laser_visibility="true"
        app:zxing_viewfinder_mask="#A8151116" />

    <TextView
        android:id="@+id/scanner_context_prompt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</LinearLayout>
