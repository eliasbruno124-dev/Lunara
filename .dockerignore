# Send only inputs used by infra/docker/api.Dockerfile to the builder. Parent
# directories are reopened and their contents are immediately closed again;
# only the explicit paths below can enter the build context.
**

!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!eslint.config.mjs

!apps
apps/**
!apps/web
apps/web/**
!apps/web/package.json
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/index.html
!apps/web/public
!apps/web/public/**
!apps/web/src
!apps/web/src/**

!services
services/**
!services/api
services/api/**
!services/api/package.json
!services/api/nest-cli.json
!services/api/tsconfig.json
!services/api/tsconfig.build.json
!services/api/jest.config.cjs
!services/api/prisma
!services/api/prisma/**
!services/api/src
!services/api/src/**

# npm validates every workspace manifest referenced by the root lockfile.
!packages
packages/**
!packages/openapi-client
packages/openapi-client/**
!packages/openapi-client/package.json

!infra
infra/**
!infra/docker
infra/docker/**
!infra/docker/api.Dockerfile

# Only the signed installable APK belongs in the runtime image; never signing
# material, deployment credentials or the rest of the artifact directory.
!artifacts
artifacts/**
!artifacts/lunara-release.apk
