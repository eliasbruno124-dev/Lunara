# Copy to .env and fill in. Never publish your .env.

# Image version (see GitHub releases)
LUNARA_VERSION=1.3.5

# Public address – must start with https://
PUBLIC_BASE_URL=https://lunara.example.com
# Only for the caddy profile: the same domain without https://
LUNARA_DOMAIN=lunara.example.com

# Local port if you use your own reverse proxy
LUNARA_PORT=3000
TZ=Europe/Berlin
REGISTRATION_ENABLED=false

# ---- Secrets: generate every value separately -------------------------
# POSTGRES_PASSWORD:      openssl rand -hex 32
# APP_MASTER_KEY:         openssl rand -base64 32   (exactly 32 bytes!)
# AUTH_SIGNING_KEY:       openssl rand -base64 48
# REFRESH_TOKEN_PEPPER:   openssl rand -base64 48
# BOOTSTRAP_TOKEN:        openssl rand -hex 24      (remove after setup)
POSTGRES_PASSWORD=
APP_MASTER_KEY=
AUTH_SIGNING_KEY=
REFRESH_TOKEN_PEPPER=
BOOTSTRAP_TOKEN=
