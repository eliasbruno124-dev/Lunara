# Kopieren nach .env und ausfüllen. Die .env niemals veröffentlichen.

# Version des Images (siehe GitHub-Releases)
LUNARA_VERSION=1.3.4

# Öffentliche Adresse – muss mit https:// beginnen
PUBLIC_BASE_URL=https://lunara.example.com
# Nur für das Caddy-Profil: dieselbe Domain ohne https://
LUNARA_DOMAIN=lunara.example.com

# Lokaler Port, falls du einen eigenen Reverse-Proxy verwendest
LUNARA_PORT=3000
TZ=Europe/Berlin
REGISTRATION_ENABLED=false

# ---- Geheimnisse: jeden Wert einzeln neu erzeugen ----------------------
# POSTGRES_PASSWORD:      openssl rand -hex 32
# APP_MASTER_KEY:         openssl rand -base64 32   (genau 32 Byte!)
# AUTH_SIGNING_KEY:       openssl rand -base64 48
# REFRESH_TOKEN_PEPPER:   openssl rand -base64 48
# BOOTSTRAP_TOKEN:        openssl rand -hex 24      (nach der Einrichtung löschen)
POSTGRES_PASSWORD=
APP_MASTER_KEY=
AUTH_SIGNING_KEY=
REFRESH_TOKEN_PEPPER=
BOOTSTRAP_TOKEN=
