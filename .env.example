# Public, non-secret configuration
APP_NAME=Lunara
APP_VERSION=1.5.1
PUBLIC_BASE_URL=https://lunara.example.com
PUBLIC_HOST=lunara.example.com
# direct: Traefik routes straight to Lunara and Lunara handles login itself.
# Proxy mode routes requests through Pangolin/Traefik; optional OIDC remains
# optional until configure-authentik-oidc.sh has created its public settings.
GATEWAY_MODE=direct
POSTGRES_DB=lunara
POSTGRES_USER=lunara
REGISTRATION_ENABLED=false

# Optional personal Authentik OIDC. Without enabling it, Lunara username/password
# sign-in remains fully available. The provisioning script writes the matching
# non-secret values locally on the server to
# /docker/lunara/authentik-oidc.env. Never embed a client secret in the APK/PWA.
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=Authentik
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_SCOPES=openid offline_access
OIDC_DISCOVERY_URL=
OIDC_JWKS_URL=
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_MAX_TOKEN_AGE_SECONDS=3600
OIDC_CLOCK_TOLERANCE_SECONDS=30
NTPY_ENABLED=false
NTPY_BASE_URL=
# OpenAPI is off by default. If enabled, either protect it with Authentik or
# configure a dedicated docs password (16+ characters); never expose it open.
OPENAPI_ENABLED=false
OPENAPI_TRUST_AUTHENTIK=false
OPENAPI_USERNAME=
OPENAPI_PASSWORD=
CORS_ORIGINS=
# Official/production builds use an Android-verified HTTPS callback. Enable
# this only after entering the SHA-256 fingerprint of the release/Play signing
# certificate. Multiple fingerprints are comma-separated.
ANDROID_APP_LINK_ENABLED=false
ANDROID_APP_LINK_PACKAGE=de.lunara.app
ANDROID_APP_LINK_CERT_SHA256=
LOG_LEVEL=info
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_MINUTES=30
TZ=Europe/Berlin

# Docker network used by Traefik/Pangolin on the target host.
PROXY_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Secrets: generate unique random values; never commit the real .env.
# openssl rand -base64 48
POSTGRES_PASSWORD=replace-with-a-long-random-value
APP_MASTER_KEY=replace-with-32-byte-base64-key
AUTH_SIGNING_KEY=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
# Required for a fresh server. It may be removed after successful bootstrap.
BOOTSTRAP_TOKEN=replace-with-one-time-random-token

# Lunara's API is never exposed directly. Pangolin routes only to Authentik;
# Authentik proxies authenticated traffic to the API (see DEPLOYMENT.md).
