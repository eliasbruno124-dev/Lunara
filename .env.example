# Public, non-secret configuration
APP_NAME=Lunara
APP_VERSION=1.0.0
PUBLIC_BASE_URL=https://lunara.example.com
PUBLIC_HOST=lunara.example.com
POSTGRES_DB=lunara
POSTGRES_USER=lunara
REGISTRATION_ENABLED=false
# Exakte bestehende Authentik-Benutzernamen mit interaktivem Lunara-Zugriff.
LUNARA_AUTHENTIK_HUMAN_USERS=Dune,Elias
NTPY_ENABLED=false
NTPY_BASE_URL=
# Swagger UI is externally protected by Authentik. The API has no host port.
OPENAPI_ENABLED=true
OPENAPI_TRUST_AUTHENTIK=true
CORS_ORIGINS=
LOG_LEVEL=info
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_MINUTES=30
TZ=Europe/Berlin

# Docker network used by Traefik/Pangolin on the target host.
PROXY_NETWORK=pangolin

# Secrets: generate unique random values; never commit the real .env.
# openssl rand -base64 48
POSTGRES_PASSWORD=replace-with-a-long-random-value
APP_MASTER_KEY=replace-with-32-byte-base64-key
AUTH_SIGNING_KEY=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
BOOTSTRAP_TOKEN=replace-with-one-time-random-token

# Lunara's API is never exposed directly. Pangolin routes only to Authentik;
# Authentik proxies authenticated traffic to the API (see DEPLOYMENT.md).
