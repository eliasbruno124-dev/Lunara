generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TRACKER
  PARTNER
}

enum PreferredLanguage {
  DE
  EN
}

enum SpecialMode {
  NONE
  HORMONAL_CONTRACEPTION
  PREGNANCY
  POSTPARTUM
  MENOPAUSE_TRANSITION
  PAUSED
}

enum PeriodSource {
  MANUAL
  IMPORT
  SYNC
}

enum FlowLevel {
  SPOTTING
  LIGHT
  MEDIUM
  HEAVY
}

enum OvulationTestResult {
  NEGATIVE
  POSITIVE
  UNCLEAR
}

enum PredictionConfidence {
  LOW
  MEDIUM
  HIGH
  UNAVAILABLE
}

enum TipCategory {
  COMMUNICATION
  PRACTICAL_HELP
  COMFORT
  SPACE
  FOOD_AND_DRINK
  EMOTIONAL_SUPPORT
  PERIOD_DAYS
  PREMENSTRUAL_ESTIMATE
  GENERAL
  USER_DEFINED
}

enum CyclePhase {
  MENSTRUATION
  FOLLICULAR_ESTIMATE
  OVULATION_ESTIMATE
  LUTEAL_ESTIMATE
  PREMENSTRUAL_ESTIMATE
  UNKNOWN
}

enum AuditEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  NEW_DEVICE
  SESSION_REVOKED
  INVITATION_CREATED
  INVITATION_REVOKED
  SHARING_CHANGED
  DATA_EXPORTED
  ACCOUNT_DELETED
  ACCOUNT_DISABLED
  PASSWORD_CHANGED
  PASSWORD_CHANGE_FAILED
  OIDC_IDENTITY_LINKED
}

enum SessionAuthMethod {
  PASSWORD
  OIDC
}

enum SyncOperation {
  UPSERT
  DELETE
}

enum CheckInStatus {
  PENDING
  ANSWERED
  EXPIRED
  DISMISSED
}

model ServerState {
  id             Int       @id @default(1)
  bootstrappedAt DateTime?
  updatedAt      DateTime  @updatedAt
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  username          String            @unique @db.VarChar(64)
  displayName       String            @db.VarChar(120)
  passwordHash      String?
  preferredLanguage PreferredLanguage @default(DE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  disabledAt        DateTime?

  memberships       Membership[]
  sessions          DeviceSession[]
  externalIdentities ExternalIdentity[]
  cycleProfile      CycleProfile?
  periodEvents      PeriodEvent[]
  dailyLogs         DailyLog[]
  sharingSettings   SharingSettings[] @relation("SharingOwner")
  carePreferences   CarePreferences?
  predictions       Prediction[]
  tipFeedback       TipFeedback[]
  createdPartnerTips PartnerTip[]     @relation("PartnerTipCreator")
  invitations       Invitation[]      @relation("InvitationCreator")
  auditEvents       AuditEvent[]       @relation("AuditActor")
  idempotencyKeys   IdempotencyKey[]
  sentCheckIns      CheckIn[]          @relation("CheckInSender")
  receivedCheckIns  CheckIn[]          @relation("CheckInRecipient")
  customSymptoms    CustomSymptom[]
  importBatches     ImportBatch[]

  @@index([disabledAt])
}

model Household {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(120)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  memberships     Membership[]
  invitations     Invitation[]
  sharingSettings SharingSettings[]
  auditEvents     AuditEvent[]
  idempotencyKeys IdempotencyKey[]
  syncChanges     SyncChange[]
  checkIns        CheckIn[]
  partnerTips     PartnerTip[]
  importBatches   ImportBatch[]
}

model Membership {
  id              String    @id @default(uuid()) @db.Uuid
  householdId     String    @db.Uuid
  userId          String    @unique @db.Uuid
  role            UserRole
  customRoleLabel String?   @db.VarChar(80)
  permissions     Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@unique([householdId, role])
}

model DeviceSession {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  tokenFamilyId    String          @db.Uuid
  deviceName       String          @db.VarChar(120)
  refreshTokenHash String          @unique @db.Char(64)
  lastUsedAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  rotatedFromId    String?         @unique @db.Uuid
  authMethod       SessionAuthMethod @default(PASSWORD)
  externalIdentityId String?       @db.Uuid

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalIdentity ExternalIdentity? @relation(fields: [externalIdentityId], references: [id], onDelete: SetNull)
  rotatedFrom      DeviceSession?  @relation("SessionRotation", fields: [rotatedFromId], references: [id])
  rotatedTo        DeviceSession?  @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([tokenFamilyId, revokedAt])
  @@index([externalIdentityId])
}

model ExternalIdentity {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  issuer     String    @db.VarChar(512)
  subject    String    @db.VarChar(255)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions   DeviceSession[]

  @@unique([issuer, subject])
  @@unique([userId, issuer])
  @@index([userId])
}

model CycleProfile {
  id                           String      @id @default(uuid()) @db.Uuid
  userId                       String      @unique @db.Uuid
  typicalCycleLengthOptional   Int?
  typicalPeriodLengthOptional  Int?
  lutealLengthOptional         Int?
  fertilityPredictionEnabled   Boolean     @default(false)
  predictionPaused             Boolean     @default(false)
  specialMode                  SpecialMode @default(NONE)
  timezone                     String      @default("Europe/Berlin") @db.VarChar(64)
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt

  user                         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PeriodEvent {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  startDate  DateTime     @db.Date
  endDate    DateTime?    @db.Date
  source     PeriodSource @default(MANUAL)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  version    Int          @default(1)

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
  // A partial unique index in migration 20260813160000 ensures one active
  // event per user/startDate while allowing the date after a soft delete.
  // Migration 20260816120000 additionally enforces non-overlapping active
  // inclusive date ranges; a null endDate is an open-ended active range.
  @@index([userId, startDate])
  @@index([userId, updatedAt])
}

model DailyLog {
  id                       String               @id @default(uuid()) @db.Uuid
  userId                   String               @db.Uuid
  localDate                DateTime             @db.Date
  flowLevel                FlowLevel?
  painLevel                Int?
  mood                     String?              @db.VarChar(64)
  energy                   Int?
  sleepQuality             Int?
  bodyTemperature          Decimal?             @db.Decimal(4, 2)
  ovulationTestResult      OvulationTestResult?
  customSymptoms           Json                 @default("[]")
  encryptedNote            String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?
  version                  Int                  @default(1)

  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId, updatedAt])
}

model SharingSettings {
  id                       String        @id @default(uuid()) @db.Uuid
  ownerUserId              String        @db.Uuid
  householdId              String        @db.Uuid
  sharePrediction          Boolean       @default(true)
  sharePeriodDates         Boolean       @default(false)
  sharePhase               Boolean       @default(false)
  shareFlow                Boolean       @default(false)
  sharePain                Boolean       @default(false)
  shareMood                Boolean       @default(false)
  shareEnergy              Boolean       @default(false)
  shareSleep               Boolean       @default(false)
  shareSymptoms            Boolean       @default(false)
  shareNotes               Boolean       @default(false)
  shareFertileWindow       Boolean       @default(false)
  allowSymptomBasedTips    Boolean       @default(false)
  tipsEnabled              Boolean       @default(true)
  checkInsEnabled          Boolean       @default(true)
  sharingPaused            Boolean       @default(false)
  privateDate              DateTime?     @db.Date
  disabledTipCategories    TipCategory[] @default([])
  updatedAt                DateTime      @updatedAt

  owner                    User          @relation("SharingOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  household                Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, householdId])
  @@index([householdId])
}

model CarePreferences {
  id                         String   @id @default(uuid()) @db.Uuid
  userId                     String   @unique @db.Uuid
  likesWarmth                Boolean  @default(false)
  likesCuddling              Boolean  @default(false)
  likesSpace                 Boolean  @default(false)
  likesSnacks                Boolean  @default(false)
  likesConversation          Boolean  @default(false)
  likesHouseholdHelp         Boolean  @default(false)
  likesReminders             Boolean  @default(false)
  dislikesUnsolicitedAdvice  Boolean  @default(true)
  customHelpfulActions       Json     @default("[]")
  customUnhelpfulActions     Json     @default("[]")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Prediction {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @db.Uuid
  predictedStartFrom   DateTime             @db.Date
  predictedStartTo     DateTime             @db.Date
  predictedEndFrom     DateTime             @db.Date
  predictedEndTo       DateTime             @db.Date
  fertileWindowFrom    DateTime?            @db.Date
  fertileWindowTo      DateTime?            @db.Date
  confidence           PredictionConfidence
  basedOnCycleCount    Int
  calculatedAt         DateTime             @default(now())
  algorithmVersion     String               @db.VarChar(32)
  explanation          Json
  typicalCycleLength   Int
  typicalPeriodLength  Int
  variationDays        Int

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calculatedAt])
}

model PartnerTip {
  id                    String        @id @default(uuid()) @db.Uuid
  category              TipCategory
  titleDe               String        @db.VarChar(160)
  bodyDe                String        @db.VarChar(600)
  callToActionDe        String        @db.VarChar(240)
  titleEn               String        @db.VarChar(160)
  bodyEn                String        @db.VarChar(600)
  callToActionEn        String        @db.VarChar(240)
  requiredSharedFields  String[]      @default([])
  applicablePhase       CyclePhase?
  applicableSymptoms    String[]      @default([])
  priority              Int           @default(0)
  enabled               Boolean       @default(true)
  createdByUserId       String?       @db.Uuid
  householdId           String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  feedback              TipFeedback[]
  createdBy             User?         @relation("PartnerTipCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  household             Household?    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([category, enabled, priority])
  @@index([createdByUserId, householdId, enabled])
  @@index([householdId, category, enabled])
}

model TipFeedback {
  id          String     @id @default(uuid()) @db.Uuid
  tipId       String     @db.Uuid
  userId      String     @db.Uuid
  helpful     Boolean?
  dismissed   Boolean    @default(false)
  createdAt   DateTime   @default(now())

  tip         PartnerTip @relation(fields: [tipId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tipId, userId])
}

model Invitation {
  id                String     @id @default(uuid()) @db.Uuid
  householdId       String     @db.Uuid
  tokenHash          String     @unique @db.Char(64)
  assignedRole       UserRole
  expiresAt          DateTime?
  usedAt             DateTime?
  revokedAt          DateTime?
  createdByUserId    String     @db.Uuid
  createdAt          DateTime   @default(now())

  household          Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy          User       @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([householdId, expiresAt])
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  householdId    String?        @db.Uuid
  actorUserId    String?        @db.Uuid
  type           AuditEventType
  ipHash         String?        @db.Char(64)
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now())

  household      Household?     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor          User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
  @@index([actorUserId, createdAt])
}

model IdempotencyKey {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  householdId    String     @db.Uuid
  key            String     @db.VarChar(128)
  method         String     @db.VarChar(12)
  path           String     @db.VarChar(240)
  requestHash    String     @db.Char(64)
  responseStatus Int
  responseBody   Json
  createdAt      DateTime   @default(now())
  expiresAt      DateTime

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household      Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}

model SyncChange {
  cursor         BigInt        @id @default(autoincrement())
  householdId    String        @db.Uuid
  ownerUserId    String        @db.Uuid
  entityType     String        @db.VarChar(40)
  entityId       String        @db.Uuid
  operation      SyncOperation
  entityVersion  Int
  occurredAt     DateTime      @default(now())

  household      Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, cursor])
  @@index([ownerUserId, cursor])
}

model CheckIn {
  id              String        @id @default(uuid()) @db.Uuid
  householdId     String        @db.Uuid
  senderUserId    String        @db.Uuid
  recipientUserId String        @db.Uuid
  prompt          String        @db.VarChar(240)
  response        String?       @db.VarChar(500)
  status          CheckInStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  answeredAt      DateTime?

  household       Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sender          User          @relation("CheckInSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient       User          @relation("CheckInRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, status, expiresAt])
}

model CustomSymptom {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  label       String   @db.VarChar(80)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
}

model ImportBatch {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  householdId    String     @db.Uuid
  sourceFormat   String     @db.VarChar(32)
  recordsCreated Int        @default(0)
  recordsSkipped Int        @default(0)
  reversibleUntil DateTime?
  createdAt      DateTime   @default(now())

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household      Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
